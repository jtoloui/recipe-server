{
  "name": "recipe-express",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "TZ=UTC bun ./scripts/prebuild.js",
    "prebuild:bun": "TZ=UTC bun ./scripts/prebuild-bun.js",
    "build": "TZ=UTC tsc && tsc-alias",
    "build:bun": "NODE_ENV=production TZ=UTC bun ./build.ts",
    "start": "TZ=UTC bun dist/index.js",
    "start:bun": "TZ=UTC bun ./out/index.js",
    "dev": "TZ=UTC ts-node -r tsconfig-paths/register index.ts",
    "watch": "nodemon --watch src --exec TZ=UTC ts-node index.ts",
    "dev:bun": "bun --hot run index.ts",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.540.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.354.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/client-ssm": "^3.540.0",
    "@types/mongoose": "^5.11.97",
    "amazon-cognito-identity-js": "^6.2.0",
    "aws-jwt-verify": "^5.2.1",
    "axios": "^1.20.0",
    "body-parser": "^1.20.2",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-session": "^1.17.3",
    "express-winston": "^4.2.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "jwk-to-pem": "^2.0.5",
    "mongodb": "^7.6.0",
    "mongoose": "^7.8.12",
    "multer": "^2.4.0",
    "rimraf": "^5.0.5",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@types/bun": "^1.1.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.1.4",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^8.0.1",
    "git-rev-sync": "^3.0.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "elliptic": ">=6.6.1",
    "fast-xml-parser": ">=4.4.1 <5",
    "shell-quote": ">=1.10.0",
    "lodash": ">=4.17.21",
    "jws": ">=3.2.3 <4"
  }
}
