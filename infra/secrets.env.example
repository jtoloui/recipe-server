# Copy to secrets.env (gitignored) and fill with real values, then run
# ./scripts/put-secrets.sh to load them into SSM. NEVER commit secrets.env.

# MongoDB Atlas connection string (from Render env MONGODB_URI)
MONGO_URI=

# Express session secret (from Render env SESSION_SECRET)
SESSION_SECRET=

# Google OAuth client (same GCP client as today; add the new Cognito
# hosted-UI domain's /oauth2/idpresponse to its redirect URIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NOTE: S3 image uploads no longer use static keys — the Lambda's IAM role is
# granted RW on the image bucket directly. Pass the bucket name at deploy via
# `-c s3BucketName=<bucket>` (not a secret).
